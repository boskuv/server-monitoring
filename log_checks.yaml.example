# Copy to log_checks.yaml and customize for your stack.
# Enable in .env: LOG_CHECKS_ENABLED=true

enabled: true

containers:
  - name: backend
    match: "backend"
    error_pattern: "(?i)(error|exception|traceback|critical)"
    extract:
      - label: order_id
        pattern: "order_id[=: ]+(\\d+)"
      - label: user_id
        pattern: "user_id[=: ]+(\\w+)"
    max_samples: 2

  - name: tg-bot
    match: ".*bot.*"
    error_pattern: "(?i)error"

  - name: postgres
    match: "postgres"
    error_pattern: "(?i)(error|fatal|panic)"

  # Caddy: access log on stdout (enable JSON access logging in Caddyfile).
  # Failed basic auth appears as HTTP 401 in access logs.
  - name: caddy
    match: "caddy"
    error_pattern: '"status":401'
    extract:
      - label: ip
        pattern: '"remote_ip":"([^"]+)"'
      - label: host
        pattern: '"host":"([^"]+)"'
    max_samples: 5

# Host system logs (SSH auth, etc.) — path is inside the monitor container.
# With docker-compose, /host is the server root (see README).
host_logs:
  - name: auth
    path: /host/var/log/auth.log
    error_pattern: "(?i)(failed password|invalid user|authentication failure|accepted password|accepted publickey)"
    extract:
      - label: ip
        pattern: "from ([\\d.]+) port"
      - label: user
        pattern: "for (?:invalid user )?(\\S+)"
    max_samples: 3

  # Caddy access log file (alternative to container stdout above — use one, not both).
  # Mount /var/log/caddy on the host and enable JSON format in Caddyfile.
  - name: caddy-auth-fail
    path: /host/var/log/caddy/access.log
    error_pattern: '"status":401'
    extract:
      - label: ip
        pattern: '"remote_ip":"([^"]+)"'
      - label: host
        pattern: '"host":"([^"]+)"'
    max_samples: 5

  - name: caddy-forbidden
    path: /host/var/log/caddy/access.log
    error_pattern: '"status":403'
    extract:
      - label: ip
        pattern: '"remote_ip":"([^"]+)"'
    max_samples: 3

# Telegram Bot API credentials
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional settings
# DISK_WARN_PERCENT=80
# STATE_FILE=/data/net_state.json
# HOSTNAME_OVERRIDE=my-server

# Docker log monitoring (optional)
# LOG_CHECKS_ENABLED=false
# LOG_CHECKS_FILE=/config/log_checks.yaml
# LOG_STATE_FILE=/data/log_state.json
# LOG_DEFAULT_LOOKBACK_MINUTES=15

# Report delivery (optional)
# REPORT_MODE=always                  # always | scheduled_or_alert
# REPORT_DAILY_HOUR=9                 # UTC hour for daily full report
# REPORT_DAILY_MINUTE=0               # UTC minute for daily full report
# REPORT_STATE_FILE=/data/report_state.json
# CPU_ALERT_PERCENT=90                # 0 = disabled
# RAM_ALERT_PERCENT=85
# DISK_ALERT_PERCENT=90
# LOAD_ALERT_PER_CORE=2.0
# NET_RX_ALERT_MBPS=50
# NET_TX_ALERT_MBPS=50
# LOG_ERRORS_TRIGGER_ALERT=true
# ALERT_COOLDOWN_MINUTES=120
# LOG_REPORT_ATTACH_HTML=true          # send full log error details as HTML file
# LOG_REPORT_ATTACH_ON_ALERT=true      # false = attach HTML only to daily/full reports
